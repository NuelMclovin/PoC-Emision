# Endurece npm ante proxies corporativos lentos o inestables: reintenta en
# vez de fallar al primer timeout. El proxy en sí se configura vía las
# variables de entorno HTTP_PROXY/HTTPS_PROXY (ver Dockerfile y docker-compose.yml),
# no aquí, para no dejar credenciales de proxy escritas en el repositorio.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
maxsockets=4